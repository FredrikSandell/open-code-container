# Copy to .env for `make run`. Secrets go in ./secrets/ (see README).

# GitHub Enterprise Server
GHES_HOST=ghes.example.com
# GHES_API_URL=https://ghes.example.com/api/v3

# GitHub App used for clone/fetch and read-only gh/API calls
GHAPP_READ_ID=12
# GitHub App used for push and state-changing gh/API calls
GHAPP_WRITE_ID=34

# Branches the container may push to (empty disables the guard)
AGENT_BRANCH_PREFIX=agent/
# Owner used by gh when it can't infer one from -R or the current repo
# GHAPP_DEFAULT_OWNER=my-org

# Basic auth username for the web UI / API (password: secrets/server-password)
OPENCODE_SERVER_USERNAME=opencode

# Commit identity; defaults to the write app's bot user
# GIT_USER_NAME=
# GIT_USER_EMAIL=
