#!/usr/bin/env bash
# git credential helper for the GHES host, backed by GitHub App tokens.
#
# Pushes get a token from the write app, everything else (clone, fetch,
# pull, ls-remote) from the read app. git doesn't tell credential helpers
# which operation they serve, so we look for a `git push` among our
# ancestors (helper <- git-remote-https <- git push). Requires
# credential.useHttpPath so we see the repo owner.
set -euo pipefail
# shellcheck source=../lib/common.sh
. /opt/occ/lib/common.sh

# git_subcommand <pid> - prints the subcommand of a git process, if it is one.
git_subcommand() {
  local -a argv
  local i
  mapfile -d '' argv < "/proc/$1/cmdline" 2>/dev/null || return 0
  [[ ${argv[0]:-} == git || ${argv[0]:-} == */git ]] || return 0
  for ((i = 1; i < ${#argv[@]}; i++)); do
    case ${argv[i]} in
      -C | -c) ((i++)) ;;
      -*) ;;
      *) printf '%s' "${argv[i]}"; return ;;
    esac
  done
}

is_push() {
  local pid=$PPID
  for _ in 1 2 3 4 5 6; do
    case $(git_subcommand "$pid") in
      push | send-pack) return 0 ;;
    esac
    pid=$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null) || return 1
    [[ -n $pid && $pid != 0 ]] || return 1
  done
  return 1
}

declare -A cred=()
while IFS= read -r line && [[ -n $line ]]; do
  cred[${line%%=*}]=${line#*=}
done

[[ ${cred[host]:-} == "${GHES_HOST:-}" ]] || exit 0
owner=${cred[path]:-}
owner=${owner%%/*}
[[ -n $owner ]] || exit 0

case ${1:-} in
  get)
    role="read"
    if [[ ${GHAPP_ROLE:-} == write ]] || is_push; then role="write"; fi
    token=$(/opt/occ/bin/ghapp-token "$role" "$owner") || exit 0
    printf 'username=x-access-token\npassword=%s\n' "$token"
    ;;
  erase)
    # The server rejected a token; mint fresh ones next time.
    /opt/occ/bin/ghapp-token --invalidate "$owner"
    ;;
esac
